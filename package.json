{
    "name": "dev-bubbles",
    "version": "0.1.0",
    "description": "Live bubble map of a git repo, grouped and labeled by your coding agent",
    "license": "MIT",
    "type": "module",
    "bin": {
        "dev-bubbles": "dist/bin/cli.js"
    },
    "files": [
        "dist",
        "templates",
        "skills"
    ],
    "engines": {
        "node": ">=22.12"
    },
    "scripts": {
        "dev": "concurrently -k -n server,web \"tsx watch bin/cli.ts --port 4747\" \"vite\"",
        "build": "vite build && tsc -p tsconfig.build.json",
        "prepare": "npm run build",
        "start": "node dist/bin/cli.js",
        "test": "vitest run",
        "typecheck": "tsc --noEmit",
        "fixture": "tsx scripts/make-fixture.ts",
        "demo:bug": "tsx scripts/demo-bug.ts"
    },
    "dependencies": {
        "chokidar": "^4.0.3",
        "d3": "^7.9.2",
        "micromatch": "^4.0.8",
        "oxc-parser": "^0.158.0",
        "oxc-resolver": "^11.24.2",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@types/d3": "^7.4.3",
        "@types/micromatch": "^4.0.10",
        "@types/node": "^22.20.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.3.0",
        "concurrently": "^10.0.7",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2",
        "vite": "^8.3.8",
        "vitest": "^5.1.0"
    }
}
