{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "lib": ["ES2023"],
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "types": ["node"],
        "noEmit": false,
        "allowImportingTsExtensions": false,
        "rewriteRelativeImportExtensions": true,
        "rootDir": ".",
        "outDir": "dist"
    },
    "include": ["bin", "server", "shared"],
    "exclude": ["**/*.test.ts"]
}
